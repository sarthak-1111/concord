LLM_BASE_URL=https://your-endpoint.example.com
LLM_API_KEY=your-key-here
LLM_MODEL=gpt-oss:120b
# Optional: Materials Project structures as an extra data source
MP_API_KEY=
# Optional: the external "eye" fit reviewer, never vendored: the PDF agent's residual reader,
# e.g. ../concord-ref/pdf_backend/app/modules/agent/residual.py (absolute path)
EYE_MODULE_PATH=
# Only if this machine has no SSH key with access to the reference repos: a Bitbucket API token with repository
# read scope, with your Bitbucket username (or the fixed API-token username in Bitbucket's "Using API tokens" page)
REF_GIT_USERNAME=
REF_GIT_TOKEN=
# Optional: free OpenAlex key (openalex.org/settings/api) for the paper miner; without one, OpenAlex allows
# about 100 searches a day per IP address, which the cache makes plenty
OPENALEX_API_KEY=
